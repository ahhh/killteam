{
  "name": "kill-team-battle-simulator",
  "version": "0.1.0",
  "description": "Deterministic, data-driven skirmish battle simulator. Static single-page app, no build step.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node --test 'test/*.test.mjs'",
    "test:data": "node test/validate-data.mjs",
    "smoke": "node test/smoke.mjs",
    "batch": "node test/batch.mjs",
    "killzone": "node test/killzone.mjs",
    "test:manifest": "node tools/make-team-manifest.mjs",
    "data:index": "node tools/make-data-index.mjs",
    "map:art": "node tools/make-map-art.mjs",
    "melee": "node test/melee-ab.mjs"
  },
  "engines": {
    "node": ">=20"
  },
