  "factionRules": [
    {
      "id": "aspect-techniques",
      "name": "Aspect Techniques",
      "description": "Each ASPECT TECHNIQUE is in a category: Dire Avenger, Howling Banshee and Striking Scorpion. Each ASPECT TECHNIQUE can only be used with a friendly operative that has the matching Aspect keyword, and each will specify when it can be used and what its effects are. In addition: You cannot use more than one ASPECT TECHNIQUE per activation or counteraction.You cannot use each ASPECT TECHNIQUE more than once per turning point.If every friendly BLADES OF KHAINE operative selected for deployment has the same Aspect keyword (e.g. STRIKING SCORPION), you cannot use each ASPECT TECHNIQUE more than twice per turning point (instead of once)."
    }
  ],
  "strategicPloys": [
    {
      "id": "forewarned",
      "name": "FOREWARNED",
      "description": "Whenever an operative is shooting a ready friendly BLADES OF KHAINE operative, you can re-roll any of your defence dice results of one result (e.g. results of 2).",
      "cost": 1,
      "hooks": [
        {
          "trigger": "beforeDefenceRoll",
          "condition": {
            "selfReady": true
          },
          "effect": {
            "type": "rerollDefenceDice",
            "count": 3
          }
        }
      ]
    },
    {
      "id": "ruthless-poise",
      "name": "RUTHLESS POISE",
      "description": "Whenever a friendly BLADES OF KHAINE operative is fighting a ready enemy operative, that friendly operative's melee weapons have the Ceaseless weapon rule.",
      "cost": 1,
      "hooks": [
        {
          "trigger": "beforeAttackRoll",
          "condition": {
            "weaponType": "melee",
            "targetReady": true
          },
          "effect": {
            "type": "grantWeaponRule",
            "rules": [
              "ceaseless"
            ]
          }
        }
      ]
    },
    {
      "id": "khaine-s-vengeance",
      "name": "KHAINE'S VENGEANCE",
      "description": "Whenever a friendly BLADES OF KHAINE operative is shooting an expended enemy operative, that friendly operative's ranged weapons have the Ceaseless weapon rule.",
      "cost": 1,
      "hooks": [
        {
          "trigger": "beforeAttackRoll",
          "condition": {
            "weaponType": "ranged",
            "targetReady": false
          },
          "effect": {
            "type": "grantWeaponRule",
            "rules": [
              "ceaseless"
            ]
          }
        }
      ]
    },
    {
      "id": "dance-of-death",
      "name": "DANCE OF DEATH",
      "description": "Select two friendly BLADES OF KHAINE operatives visible to and within 6\" of each other. Remove them both from the killzone and set them back up in each other's previous locations (in other words, swap their positions).",
      "cost": 1
    }
  ],
  "firefightPloys": [
    {
      "id": "bladewind1cp",
      "name": "BLADEWIND1CP",
      "description": "Use this firefight ploy during a friendly BLADES OF KHAINE operative's activation. During that activation, that operative can perform two Fight actions.",
      "cost": 1
    },
    {
      "id": "starfall1cp",
      "name": "STARFALL1CP",
      "description": "Use this firefight ploy during a friendly BLADES OF KHAINE operative's activation. During that activation, that operative can perform two Shoot actions.",
      "cost": 1
    },
    {
      "id": "fading-light1cp",
      "name": "FADING LIGHT1CP",
      "description": "Use this firefight ploy during a friendly BLADES OF KHAINE operative's activation, before or after it performs an action. During that activation, that operative can perform the Fall Back action for 1 less AP.",
      "cost": 1
    },
    {
      "id": "contempt1cp",
      "name": "CONTEMPT1CP",
      "description": "Use this firefight ploy when a friendly BLADES OF KHAINE operative is retaliating or an enemy operative is shooting it, after your opponent rolls their attack dice, but before re-rolls. Until the end of the sequence, your opponent cannot re-roll their attack dice (if your opponent declared the use of any firefight ploys during that sequence that would allow them to re-roll, that ploy is cancelled and the CP spent on it is refunded).",
      "cost": 1
    }
  ],
  "equipment": [
    {
      "id": "rune-of-prophecy",
      "name": "RUNE OF PROPHECY",
      "description": "Once per battle, after rolling off to decide initiative, you can add D3 to, or subtract D3 from, your result."
    },
    {
      "id": "rune-of-shielding",
      "name": "RUNE OF SHIELDING",
      "description": "Once per battle, when an attack dice inflicts Normal Dmg on a friendly BLADES OF KHAINE operative, you can ignore that inflicted damage."
    },
    {
      "id": "rune-of-foresight",
      "name": "RUNE OF FORESIGHT",
      "description": "When this equipment is revealed, roll one D3. In the Strategy phase of the turning point equal to the result, you gain 1 additional CP."
    },
    {
      "id": "wraithbone-talisman",
      "name": "WRAITHBONE TALISMAN",
      "description": "Once per turning point, when a friendly BLADES OF KHAINE operative is shooting, fighting or retaliating, if you roll two or more fails, you can discard one of them to retain another as a normal success instead."
    }
  ],
  "ruleHooks": []
}
