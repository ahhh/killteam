  "id": "deathwatch",
  "factionId": "space-marines",
  "displayName": "Deathwatch",
  "blurb": "Deathwatch kill teams combat the xenos foes of the Imperium with adaptive expertise and specialist weaponry. They wield some of Humanity's most highly advanced weapons alongside more esoteric equipment. Besides their superhuman strength and speed, the Deathwatch bring to the battlefield their hatred of the xenos in all its forms.",
  "edition": "kill-team-3",
  "dataVersion": "2026-09-10",
  "supportLevel": 3,
